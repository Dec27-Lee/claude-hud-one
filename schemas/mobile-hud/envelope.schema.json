{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude-hud-one.local/schemas/mobile-hud/envelope.schema.json",
  "title": "Mobile HUD Fixture Document",
  "type": "object",
  "required": ["name", "description", "envelope", "androidFallback"],
  "additionalProperties": true,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "envelope": {
      "type": "object",
      "required": ["protocolVersion", "messageId", "seq", "kind", "sentAt", "payload"],
      "additionalProperties": true,
      "properties": {
        "protocolVersion": { "type": "integer", "const": 1 },
        "messageId": { "type": "string", "minLength": 1 },
        "seq": { "type": "integer", "minimum": 0 },
        "kind": { "type": "string", "minLength": 1 },
        "sentAt": { "type": "string", "minLength": 1 },
        "snapshotVersion": { "type": "integer", "minimum": 0 },
        "payload": { "$ref": "./view-model.schema.json" }
      }
    },
    "androidFallback": { "type": "object" }
  }
}
