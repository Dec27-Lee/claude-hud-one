  "deniedJsonKeys": [
    "transcriptPath",
    "projectDir",
    "cwd",
    "terminal",
    "intentId",
    "allowedIntents",
    "nonce",
    "rawInput",
    "rawOutput",
    "toolInput",
    "toolResult",
    "wtSession",
    "windowTitleHint",
    "bridgeProcessId"
  ],
  "deniedTextMarkers": [
    "transcript_path",
    "project_dir",
    "tool input",
    "tool result",
    "raw prompt",
    "raw output"
  ],
  "pcOnlyFields": [
    "transcriptPath",
    "projectDir",
    "cwd",
    "terminal",
    "pendingQueue.intentId",
    "pendingQueue.allowedIntents",
    "pendingQueue.nonce",
    "hook.rawInput",
    "hook.toolInput",
