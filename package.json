{
  "name": "claude-hud-one",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check:version": "node scripts/check-version.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml -j 1 usage_cost && cargo test --manifest-path src-tauri/Cargo.toml -j 1 mobile_hud && cargo test --manifest-path src-tauri/Cargo.toml -j 1 claude_status",
    "test:rust:mobile": "cargo test --manifest-path src-tauri/Cargo.toml -j 1 mobile_hud",
    "generate:protocol": "node scripts/generate-mobile-hud-protocol.mjs --write",
    "check:protocol-generated": "node scripts/generate-mobile-hud-protocol.mjs --check",
    "test:protocol": "node scripts/check-mobile-hud-protocol.mjs && node scripts/generate-mobile-hud-protocol.mjs --check",
    "test:privacy": "node scripts/check-mobile-hud-protocol.mjs",
    "test:bridge": "cargo test --manifest-path src-tauri/Cargo.toml -j 1 hud_bridge",
    "test:security": "cargo test --manifest-path src-tauri/Cargo.toml -j 1 mobile_intent",
    "test:android": "powershell -ExecutionPolicy Bypass -File scripts/android-gradle.ps1 :app:testDebugUnitTest",
    "lint:android": "powershell -ExecutionPolicy Bypass -File scripts/android-gradle.ps1 :app:lintDebug",
    "build:android": "powershell -ExecutionPolicy Bypass -File scripts/android-gradle.ps1 :app:assembleDebug",
    "build:android:fresh": "powershell -ExecutionPolicy Bypass -File scripts/android-gradle.ps1 :app:clean :app:assembleDebug",
    "build:bridge": "node scripts/build-hud-bridge.mjs",
    "ui": "node scripts/test-ui.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "test:ui:headed": "node scripts/test-ui.mjs --headed",
    "test:visual": "node scripts/test-ui.mjs tests/visual.spec.ts",
    "test:visual:update": "node scripts/test-ui.mjs tests/visual.spec.ts --update-snapshots",
    "smoke": "powershell -ExecutionPolicy Bypass -File scripts/smoke.ps1",
    "verify:r6": "powershell -ExecutionPolicy Bypass -File scripts/verify-r6.ps1",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tauri-apps/cli": "^2.8.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  }
}
